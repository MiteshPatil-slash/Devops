# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ai-deploy

# Auth
JWT_SECRET=change_this_to_a_long_random_string
SESSION_SECRET=change_this_too_a_different_long_random_string
JWT_EXPIRES_IN=7d

# Dev-only OTP bypass (Phase 1 — real Gmail OTP comes later)
DEV_FIXED_OTP=1111

# GitHub OAuth (see SETUP.md for how to create these)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# AI Agent (Anthropic / Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_MODEL=claude-sonnet-4-6

# Generation / Docker orchestration
GENERATED_APPS_DIR=./generated-apps
DOCKER_PORT_RANGE_START=6000
DOCKER_PORT_RANGE_END=6999
